MONGO_URI=mongodb://localhost:27017
MONGO_DB=emobooks_db
# MongoDB stores admin accounts/sessions only. Books and model results use Neo4j.
# For Aura, use the neo4j+s:// URI supplied by your instance.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
MODEL_DIR=models/final_hierarchical_emotion_model
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_HOURS=8
# Optional: cpu or cuda. Empty selects CUDA when available, otherwise CPU.
MODEL_DEVICE=
# Public recommendation model and its locally downloaded Sentence-BERT encoder.
RECOMMENDER_DIR=models/goodreads_hybrid_recommender_v2
RECOMMENDER_ENCODER_DIR=models/recommender_encoder
RECOMMENDER_CANDIDATE_LIMIT=2000
